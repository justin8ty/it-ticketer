# Flask
SECRET_KEY=replace-me
APP_BASE_URL=http://localhost:8080

# Database
DB_ENGINE=sqlite
SQLITE_PATH=/app/data/ticketdb.sqlite3

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
HEALTH_AI_ENABLED=false
HEALTH_AI_QUESTION_COUNT=5

# Email notifications
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# Telegram notifications
NOTIFY_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
